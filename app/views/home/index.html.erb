  .whisper, .lock {
    position: absolute;
    top: 0;
    width: 50%;
    opacity: 0;
    transition: opacity 1s ease-in-out, left 1s ease-in-out; /* Smooth fade-in and slide animation */
  }

  .whisper {
    left: -100%;
  }

  .lock {
    right: -100%;
    text-align: right; /* Align text to the right */
  }

  .animate .whisper {
    opacity: 1;
    left: 0;
  }

  .animate .lock {
    opacity: 1;
    right: 0;
  }

</style>



